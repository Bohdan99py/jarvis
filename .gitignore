# API key (NEVER commit this!)
# embedded_key.h
# Одноразовые скрипты сборки с зашитыми абсолютными путями и их логи.
# Паттерном, а не поимённо: они создаются под конкретную проверку и
# каждый раз называются иначе, поэтому список конкретных имён отстаёт —
# именно так build_synapse_test.* и build_focus_test.* уже попали в репозиторий.
# scripts/build_release.bat под это не подпадает: он в другой папке.
build_*.bat
build_*.log
run_*.bat
