        <file alias="MainScreen.qml">MainScreen.qml</file>
        <file alias="VisualInsights.qml">VisualInsights.qml</file>
        <file alias="VisualInsightsWeb.qml">VisualInsightsWeb.qml</file>
        <file alias="VisualInsightsSvg.qml">VisualInsightsSvg.qml</file>
