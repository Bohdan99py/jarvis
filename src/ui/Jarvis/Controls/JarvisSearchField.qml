import QtQuick
import Jarvis.Theme

// ============================================================
// JarvisSearchField — поле поиска: то же JarvisTextField, но с
// лупой, крестиком и Esc для очистки.
//
// Отдельный тип, а не три свойства на месте вызова: поиск есть на
// нескольких экранах и должен выглядеть и вести себя одинаково,
// включая Esc — про него на месте вызова забывают.
// ============================================================

JarvisTextField {
    glyph: "\u2315"
    clearable: true

    Keys.onEscapePressed: clear()
}
